# Copy to .env and adjust. Every value has a safe default; nothing here is required for the demo.

# --- Modes -------------------------------------------------------------------
# mock: deterministic, transparent policies make every agent decision (no API calls)
# live: decisions are made by the configured LLM provider (falls back to the policy on failure)
SKOPEO_MODE=mock
SKOPEO_DEMO_MODE=true            # enables POST /api/demo/investigations and the UI button
SKOPEO_DEMO_STEP_DELAY_MS=120    # presentation pacing for demo runs (0 = full speed)
SKOPEO_OFFLINE=false             # true: no network; advisories/registry come from the bundled snapshot
DRY_RUN=true                     # approved GitHub actions are recorded, never sent

# --- LLM provider (only used when SKOPEO_MODE=live) ----------------------------
LLM_PROVIDER=openai              # openai | openai_compatible | mock
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_REASONING=gpt-4o       # planning, correlation, red-team judgement
LLM_MODEL_FAST=gpt-4o-mini       # summaries, reviews, recommendation text
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_RETRIES=2
LLM_MAX_CALLS_PER_INVESTIGATION=120

# --- GitHub (optional; public repositories work without a token) --------------
GITHUB_TOKEN=

# --- Execution policy -----------------------------------------------------------
# Tests and benchmarks of cloned (untrusted) repositories only run when this is true.
# Enable it only inside an isolated container. The bundled demo fixture always runs.
SKOPEO_SANDBOX_EXECUTION=false
# Controlled failures for fault-isolation demos, e.g. performance_agent@1 or license_agent@*
SKOPEO_FAULT_INJECTION=
SKOPEO_DEMO_FAULT_INJECTION=performance_agent@1

# --- Budgets and loop limits ---------------------------------------------------------
AGENT_MAX_ITERATIONS=40
AGENT_MAX_TOOL_CALLS=400
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_RETRIES=1
INVESTIGATION_TIMEOUT_SECONDS=1200
MAX_ORCHESTRATOR_ROUNDS=6
MAX_CORRELATION_ROUNDS=3
MAX_VERIFICATION_ROUNDS=2
MAX_FOLLOWUPS_PER_ROUND=6

# --- Storage ------------------------------------------------------------------------
# DATABASE_URL=sqlite:///./backend/data/skopeo.db   (default; PostgreSQL URLs also work)
# SKOPEO_WORKSPACE_DIR=./backend/data/workspaces
CLONE_DEPTH=300

# --- Public deployment -------------------------------------------------------------------
# Required to start, cancel or approve anything when set (send as X-Skopeo-Key). Reads stay open.
SKOPEO_API_KEY=
SKOPEO_DEMO_PUBLIC=true          # the bundled reference case works without the key
RATE_LIMIT_PER_MINUTE=6          # investigations started per client address (0 = unlimited)
MAX_CONCURRENT_INVESTIGATIONS=2
SKOPEO_KEEP_WORKSPACES=true      # false deletes each clone when its case ends (the Docker image sets false)
# SKOPEO_STATIC_DIR=frontend/dist  (served automatically when built; set explicitly in containers)
# PORT=8000                       (honoured by the Docker image)

# --- API / logging ----------------------------------------------------------------------
# Comma-separated; only needed when the UI is hosted on a different origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=true
